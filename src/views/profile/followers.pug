extends ../layout

  block content

    .social-list-page

      .social-list-header
        a.back-link(href=`/profile/${profileUser.id}`)
          i.bi.bi-arrow-left
          | Volver al perfil

        .social-list-heading
          .social-list-icon
            i.bi.bi-people-fill

          div
            h1 Seguidores
            p Personas que siguen a #{profileUser.name}

      if followers.length === 0

        .profile-empty
          .profile-empty-icon
            i.bi.bi-people
          h3 Todavía no tiene seguidores
          p Cuando otros usuarios sigan este perfil aparecerán aquí.

      else

        .users-list
          each follow in followers
            if follow.followerUser
              .user-list-card

                .user-list-avatar
                  i.bi.bi-person-fill

                .user-list-info
                  h3= follow.followerUser.name
                  span Usuario de Fotaza

                a.btn.btn-outline-primary(
                  href=`/profile/${follow.followerUser.id}`
                )
                  i.bi.bi-person.me-1
                  | Ver perfil
