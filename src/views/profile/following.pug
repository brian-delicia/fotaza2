extends ../layout

  block content

    .social-list-page

      .social-list-header
        a.back-link(href=`/profile/${profileUser.id}`)
          i.bi.bi-arrow-left
          | Volver al perfil

        .social-list-heading
          .social-list-icon
            i.bi.bi-person-lines-fill

          div
            h1 Siguiendo
            p Usuarios que sigue #{profileUser.name}

      if following.length === 0

        .profile-empty
          .profile-empty-icon
            i.bi.bi-person-plus
          h3 No sigue a ningún usuario
          p Cuando empiece a seguir personas aparecerán aquí.

      else

        .users-list
          each follow in following
            if follow.followedUser
              .user-list-card

                .user-list-avatar
                  i.bi.bi-person-fill

                .user-list-info
                  h3= follow.followedUser.name
                  span Usuario de Fotaza

                a.btn.btn-outline-primary(
                  href=`/profile/${follow.followedUser.id}`
                )
                  i.bi.bi-person.me-1
                  | Ver perfil