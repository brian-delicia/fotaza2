extends ../layout

block content

  .container.py-4


    .following-header

      .following-header-icon
        i.bi.bi-person-lines-fill

      div

        h1.mb-1 Usuarios que sigue #{profileUser.name}

        p.text-muted.mb-0
          | Personas que este usuario decidió seguir.

    if following.length === 0

      .following-empty

        .following-empty-icon
          i.bi.bi-people

        h3 No sigue a nadie

        p
          | Este usuario todavía no sigue a ninguna persona.

    else

      .row.g-4

        each follow in following

          if follow.followedUser

            .col-12.col-md-6.col-lg-4

              .following-card

                .following-avatar
                  i.bi.bi-person-fill

                .following-content

                  h3= follow.followedUser.name

                  p
                    i.bi.bi-envelope.me-2
                    | #{follow.followedUser.email}

                a.btn.btn-primary.rounded-pill.w-100(
                  href=`/profile/${follow.followedUser.id}`
                )
                  i.bi.bi-person.me-2
                  | Ver perfil

    .following-back

      a.btn.btn-outline-secondary.rounded-pill(
        href=`/profile/${profileUser.id}`
      )
        i.bi.bi-arrow-left.me-2
        | Volver al perfil

