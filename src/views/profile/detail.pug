extends ../layout

block content

  .container.py-4


    if profileUser

      .profile-header

        .profile-avatar
          i.bi.bi-person-fill

        .profile-info

          h1.profile-name= profileUser.name

          p.profile-email
            i.bi.bi-envelope.me-2
            | #{profileUser.email}

          .profile-stats

            a.profile-stat(
              href=`/profile/${profileUser.id}/followers`
            )
              strong= followersCount
              span Seguidores

            a.profile-stat(
              href=`/profile/${profileUser.id}/following`
            )
              strong= followingCount
              span Siguiendo

        .profile-actions

          if user && user.id !== profileUser.id

            if isFollowing

              form(
                method="POST"
                action=`/follows/${profileUser.id}/unfollow`
              )
                button.btn.btn-outline-danger.rounded-pill.px-4(
                  type="submit"
                )
                  i.bi.bi-person-dash.me-2
                  | Dejar de seguir

            else

              form(
                method="POST"
                action=`/follows/${profileUser.id}`
              )
                button.btn.btn-primary.rounded-pill.px-4(
                  type="submit"
                )
                  i.bi.bi-person-plus.me-2
                  | Seguir

      .profile-navigation

        a.btn.btn-outline-secondary.rounded-pill(
          href=`/profile/${profileUser.id}/followers`
        )
          i.bi.bi-people.me-2
          | Seguidores

        a.btn.btn-outline-secondary.rounded-pill(
          href=`/profile/${profileUser.id}/following`
        )
          i.bi.bi-person-lines-fill.me-2
          | Siguiendo

      .profile-posts-header

        h2
          i.bi.bi-grid-3x3-gap-fill.me-2
          | Publicaciones

      if posts.length === 0

        .profile-empty

          .profile-empty-icon
            i.bi.bi-images

          h3 Sin publicaciones

          p
            | Este usuario todavía no tiene publicaciones.

      else

        .row.g-4

          each post in posts

            .col-12.col-md-6.col-xl-4

              .profile-post-card

                if post.Images && post.Images.length > 0

                  a.profile-post-image(
                    href=`/posts/${post.id}`
                  )
                    img(
                      src=`/images/${post.Images[0].id}/raw`
                      alt=post.title
                    )

                else

                  a.profile-post-image.profile-post-placeholder(
                    href=`/posts/${post.id}`
                  )
                    i.bi.bi-image

                .profile-post-content

                  h3= post.title

                  if post.description
                    p= post.description

                  a.btn.btn-primary.rounded-pill.w-100(
                    href=`/posts/${post.id}`
                  )
                    i.bi.bi-eye.me-2
                    | Ver publicación

    else

      .profile-not-found

        .profile-not-found-icon
          i.bi.bi-person-x

        h2 Usuario no encontrado

        p
          | El perfil que estás buscando no existe.

        a.btn.btn-primary.rounded-pill.px-4(
          href="/posts"
        )
          i.bi.bi-house.me-2
          | Volver a publicaciones

