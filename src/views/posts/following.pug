```pug
extends ../layout

block content

  .container.py-4

    //- ENCABEZADO
    .following-header

      .following-header-icon
        i.bi.bi-people-fill

      div
        h1.mb-1 Publicaciones de usuarios que sigo
        p.text-muted.mb-0
          | Descubrí las últimas publicaciones de las personas que seguís.

    //- ERROR
    if error
      .alert.alert-danger.d-flex.align-items-center.mb-4(role="alert")
        i.bi.bi-exclamation-triangle-fill.me-2
        span= error

    //- SIN PUBLICACIONES
    if posts.length === 0

      .following-empty

        .following-empty-icon
          i.bi.bi-images

        h3 No hay publicaciones todavía

        p.text-muted
          | Los usuarios que seguís todavía no tienen publicaciones disponibles.

    //- PUBLICACIONES
    else

      .row.g-4

        each post in posts

          .col-12.col-md-6.col-xl-4

            .following-post-card

              //- IMAGEN
              if post.Images && post.Images.length > 0

                a.following-post-image(
                  href=`/posts/${post.id}`
                )

                  img(
                    src=`/images/${post.Images[0].id}/raw`
                    alt=post.title
                  )

              else

                a.following-post-image.following-post-placeholder(
                  href=`/posts/${post.id}`
                )
                  i.bi.bi-image

              //- CONTENIDO
              .following-post-content

                //- AUTOR
                if post.User

                  .following-post-author

                    .following-author-avatar
                      i.bi.bi-person-fill

                    div
                      span.following-author-label Publicado por
                      span.following-author-name= post.User.name

                //- TÍTULO
                h3= post.title

                //- DESCRIPCIÓN
                if post.description
                  p= post.description

                //- BOTÓN
                a.btn.btn-primary.rounded-pill.w-100.mt-auto(
                  href=`/posts/${post.id}`
                )
                  i.bi.bi-eye.me-2
                  | Ver publicación

