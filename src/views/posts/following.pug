extends ../layout

  block content

    .following-page

      .following-header
        .section-kicker
          i.bi.bi-people-fill
          | Tu comunidad

        h1 Publicaciones de usuarios que sigo
        p Descubrí las últimas fotografías de las personas que seguís en Fotaza.

        a.btn.btn-outline-primary.mt-3(href="/posts")
          i.bi.bi-compass.me-1
          | Explorar todas las publicaciones

      if error
        .alert.alert-danger.fotaza-alert
          i.bi.bi-exclamation-triangle-fill.me-2
          = error

      if posts.length === 0

        .following-empty
          .following-empty-icon
            i.bi.bi-people
          h2 Todavía no hay publicaciones
          p
            | Las publicaciones de los usuarios que sigas aparecerán en este espacio.
          a.btn.btn-primary(href="/search")
            i.bi.bi-search.me-1
            | Buscar fotógrafos

      else

        .following-grid

          each post in posts

            article.following-card

              .following-card-header

                if post.User
                  a.following-author(
                    href=`/profile/${post.User.id}`
                  )
                    span.following-avatar
                      i.bi.bi-person-fill

                    span= post.User.name

              if post.Images && post.Images.length > 0

                a.following-image-link(
                  href=`/posts/${post.id}`
                )

                  img.following-image(
                    src=`/images/${post.Images[0].id}/raw`,
                    alt=post.title
                  )

                  if post.Images.length > 1
                    span.following-image-count
                      i.bi.bi-images.me-1
                      | #{post.Images.length}

              .following-card-body

                h2
                  a(href=`/posts/${post.id}`)= post.title

                if post.description
                  p= post.description

                a.following-view-link(
                  href=`/posts/${post.id}`
                )
                  | Ver publicación
                  i.bi.bi-arrow-right
