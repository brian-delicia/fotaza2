extends ../layout

  block content

    .messages-page

      .messages-header

        div
          .section-kicker
            i.bi.bi-chat-dots-fill
            | Comunicación

          h1 Conversaciones
          p Contactá con otros usuarios a través de tus intereses.

      if error
        .alert.alert-danger.fotaza-alert
          i.bi.bi-exclamation-triangle-fill.me-2
          = error

      if interests && interests.length > 0

        .conversations-list

          each interest in interests

            if interest.Image && interest.Image.Post

              .conversation-card

                .conversation-image

                  if interest.Image

                    img(
                      src=`/images/${interest.Image.id}/raw`,
                      alt="Fotografía"
                    )

                .conversation-info

                  .conversation-title

                    h2= interest.Image.Post.title

                    if interest.status === 'open'

                      span.status-badge.status-open
                        i.bi.bi-circle-fill
                        | Abierto

                    else

                      span.status-badge.status-closed
                        i.bi.bi-check-circle-fill
                        | Cerrado


                  if user.id === interest.Image.Post.user_id

                    p.conversation-participant

                      span
                        i.bi.bi-person.me-1
                        | Interesado:

                      strong= interest.User.name

                  else

                    p.conversation-participant

                      span
                        i.bi.bi-person.me-1
                        | Autor:

                      strong= interest.Image.Post.User.name


                  a.btn.btn-primary(
                    href=`/messages/interests/${interest.id}`
                  )
                    i.bi.bi-chat-dots.me-1
                    | Abrir conversación

      else

        .messages-empty

          .messages-empty-icon
            i.bi.bi-chat-square-text

          h2 No tenés conversaciones

          p
            | Cuando marques “Me interesa” en una fotografía podrás conversar con su autor.

          a.btn.btn-primary(href="/posts")
            i.bi.bi-compass.me-1
            | Explorar fotografías
