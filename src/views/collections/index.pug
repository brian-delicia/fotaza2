extends ../layout

  block content

    .collections-page

      .collections-header
        div
          .section-kicker
            i.bi.bi-bookmark-heart
            | Tu espacio

          h1 Mis colecciones
          p Guardá y organizá las fotografías que más te gustan.

        a.btn.btn-primary(href="/collections/new")
          i.bi.bi-plus-lg.me-1
          | Nueva colección

      if error
        .alert.alert-danger.fotaza-alert
          i.bi.bi-exclamation-triangle-fill.me-2
          = error

      if collections.length === 0

        .collections-empty
          .collections-empty-icon
            i.bi.bi-bookmark-heart
          h2 Todavía no tenés colecciones
          p
            | Creá una colección para guardar y organizar tus publicaciones favoritas.

          a.btn.btn-primary(href="/collections/new")
            i.bi.bi-plus-lg.me-1
            | Crear mi primera colección

      else

        .collections-grid

          each collection in collections
            a.collection-card(href=`/collections/${collection.id}`)

              .collection-card-cover
                .collection-cover-placeholder
                  i.bi.bi-images

              .collection-card-body
                h2= collection.name

                span.collection-open
                  | Abrir colección
                  i.bi.bi-arrow-right
