extends ../layout

  block content

    .search-page

      .search-header
        .section-kicker
          i.bi.bi-compass
          | Explorar Fotaza

        h1 Descubrí nuevas fotografías
        p
          | Buscá publicaciones, fotógrafos y contenido según tus intereses.

      if error
        .alert.alert-danger.fotaza-alert
          i.bi.bi-exclamation-triangle-fill.me-2
          = error

      .search-layout

        // ======================================================
        // FILTROS
        // ======================================================

        aside.search-filters

          .search-filter-header
            .search-filter-icon
              i.bi.bi-sliders

            div
              h2 Filtros
              span Refiná tu búsqueda

          form(method="GET", action="/search")

            .search-field
              label(for="search-q")
                i.bi.bi-search
                | Texto

              input#search-q.form-control(
                type="text",
                name="q",
                value=filters.q || '',
                placeholder="Título o descripción..."
              )

            .search-field
              label(for="search-tag")
                i.bi.bi-hash
                | Etiqueta

              input#search-tag.form-control(
                type="text",
                name="tag",
                value=filters.tag || '',
                placeholder="Ej. naturaleza"
              )

            .search-field
              label(for="search-author")
                i.bi.bi-person
                | Autor

              input#search-author.form-control(
                type="text",
                name="author",
                value=filters.author || '',
                placeholder="Nombre del fotógrafo..."
              )

            .search-field
              label(for="search-license")
                i.bi.bi-shield-check
                | Licencia

              select#search-license.form-select(name="license")
                option(value="") Todas las licencias
                option(
                  value="free",
                  selected=filters.license === 'free'
                ) Sin copyright
                option(
                  value="copyright",
                  selected=filters.license === 'copyright'
                ) Con copyright

            .search-field
              label(for="search-rating")
                i.bi.bi-star
                | Valoración mínima

              select#search-rating.form-select(name="minRating")
                option(value="") Cualquier valoración
                option(
                  value="1",
                  selected=filters.minRating === '1'
                ) 1 estrella o más
                option(
                  value="2",
                  selected=filters.minRating === '2'
                ) 2 estrellas o más
                option(
                  value="3",
                  selected=filters.minRating === '3'
                ) 3 estrellas o más
                option(
                  value="4",
                  selected=filters.minRating === '4'
                ) 4 estrellas o más
                option(
                  value="5",
                  selected=filters.minRating === '5'
                ) 5 estrellas

            .search-filter-actions
              button.btn.btn-primary.w-100(type="submit")
                i.bi.bi-search.me-2
                | Buscar

              a.btn.btn-outline-secondary.w-100(href="/search")
                i.bi.bi-arrow-counterclockwise.me-2
                | Limpiar filtros


        // ======================================================
        // RESULTADOS
        // ======================================================

        section.search-results

          .search-results-header
            div
              span.section-kicker Resultados
              h2 Fotografías encontradas

            if posts.length > 0
              span.results-count
                | #{posts.length} resultado#{posts.length === 1 ? '' : 's'}

          if posts.length === 0

            .search-empty
              .search-empty-icon
                i.bi.bi-search
              h3 No encontramos fotografías
              p
                | Probá modificando los filtros o utilizando términos diferentes.
              a.btn.btn-primary(href="/search")
                i.bi.bi-arrow-counterclockwise.me-1
                | Limpiar búsqueda

          else

            .search-grid

              each post in posts
                if post.Images && post.Images.length > 0

                  article.search-card

                    a.search-image-link(href=`/posts/${post.id}`)
                      img.search-image(
                        src=`/images/${post.Images[0].id}/raw`,
                        alt=post.title
                      )

                      if post.Images.length > 1
                        span.search-image-count
                          i.bi.bi-images.me-1
                          | #{post.Images.length}

                    .search-card-body

                      if post.User
                        a.search-author(href=`/profile/${post.User.id}`)
                          span.search-author-avatar
                            i.bi.bi-person-fill
                          span= post.User.name

                      h3.search-card-title
                        a(href=`/posts/${post.id}`)= post.title

                      if post.description
                        p.search-card-description= post.description

                      if post.Tags && post.Tags.length > 0
                        .search-tags
                          each tag in post.Tags
                            a.search-tag(
                              href=`/search?tag=${encodeURIComponent(tag.name)}`
                            )
                              | ##{tag.name}

                      a.search-view-link(href=`/posts/${post.id}`)
                        | Ver publicación
                        i.bi.bi-arrow-right
