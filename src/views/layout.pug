doctype html
html(lang="es")
head
meta(charset="UTF-8")
meta(name="viewport", content="width=device-width, initial-scale=1.0")
meta(name="description" content="Fotaza2 - Red social de fotografía")


title Fotaza2

link(
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
)

link(
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
)

link(
  rel="stylesheet"
  href="/css/styles.css"
)


body


//- ============================================================
//- NAVBAR
//- ============================================================

nav.navbar.navbar-expand-lg.fotaza-navbar
  .container

    //- Logo
    a.navbar-brand.fotaza-brand(href="/")
      span.brand-icon
        i.bi.bi-camera-fill
      span Fotaza2

    //- Botón mobile
    button.navbar-toggler(
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#mainNavbar"
      aria-controls="mainNavbar"
      aria-expanded="false"
      aria-label="Abrir navegación"
    )
      i.bi.bi-list

    .collapse.navbar-collapse#mainNavbar

      //- Navegación principal
      ul.navbar-nav.me-auto.mb-2.mb-lg-0

        li.nav-item
          a.nav-link(href="/")
            i.bi.bi-house-door
            span Inicio

        if user
          li.nav-item
            a.nav-link(href="/posts/following")
              i.bi.bi-people
              span Siguiendo

        li.nav-item
          a.nav-link(href="/search")
            i.bi.bi-compass
            span Explorar

        if user
          li.nav-item
            a.nav-link(href="/posts/new")
              i.bi.bi-plus-square
              span Publicar

      //- Navegación del usuario
      if user
        ul.navbar-nav.align-items-lg-center

          //- Notificaciones
          li.nav-item
            a.nav-link.nav-icon-link(
              href="/notifications"
              title="Notificaciones"
            )
              i.bi.bi-bell
              if unreadNotificationsCount > 0
                span.notification-badge= unreadNotificationsCount

          //- Mensajes
          li.nav-item
            a.nav-link.nav-icon-link(
              href="/messages"
              title="Mensajes"
            )
              i.bi.bi-chat-dots
              if unreadMessagesCount > 0
                span.notification-badge.message-badge= unreadMessagesCount

          //- Menú del usuario
          li.nav-item.dropdown
            a.nav-link.dropdown-toggle.user-menu(
              href="#"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            )
              span.user-avatar
                i.bi.bi-person-fill
              span.user-name= user.username

            ul.dropdown-menu.dropdown-menu-end.fotaza-dropdown

              li
                a.dropdown-item(href="/profile/" + user.id)
                  i.bi.bi-person-circle
                  span Mi perfil

              li
                a.dropdown-item(href="/collections")
                  i.bi.bi-bookmark
                  span Mis colecciones

              li
                a.dropdown-item(href="/interests")
                  i.bi.bi-heart
                  span Me interesa

              li
                hr.dropdown-divider

              //- Opciones relacionadas con moderación
              if user.role === "validator" || user.role === "admin"
                li
                  a.dropdown-item(href="/validator")
                    i.bi.bi-shield-check
                    span Validador

                li
                  a.dropdown-item(href="/comments/reported")
                    i.bi.bi-flag
                    span Comentarios reportados

                li
                  hr.dropdown-divider

              li
                a.dropdown-item.logout-item(href="/logout")
                  i.bi.bi-box-arrow-right
                  span Cerrar sesión

      else
        //- Usuario anónimo
        ul.navbar-nav.align-items-lg-center

          li.nav-item
            a.nav-link.login-link(href="/login")
              i.bi.bi-box-arrow-in-right
              span Iniciar sesión

          li.nav-item
            a.btn.btn-primary.register-button(href="/register")
              i.bi.bi-person-plus
              span Crear cuenta


//- ============================================================
//- CONTENIDO
//- ============================================================

main.fotaza-main

  //- Mensajes generales
  if success
    .container
      .alert.alert-success.fotaza-alert(role="alert")
        i.bi.bi-check-circle-fill
        span= success

  if error
    .container
      .alert.alert-danger.fotaza-alert(role="alert")
        i.bi.bi-exclamation-circle-fill
        span= error

  block content


//- ============================================================
//- FOOTER
//- ============================================================

footer.fotaza-footer
  .container
    .footer-content

      .footer-brand
        span.footer-logo
          i.bi.bi-camera-fill
        span Fotaza2

      p.footer-text
        | Compartí tus fotografías, descubrí nuevos talentos
        | y conectá con otros amantes de la fotografía.

      .footer-links
        if user
          a(href="/")
            | Inicio
          a(href="/search")
            | Explorar
          a(href="/posts/following")
            | Siguiendo
        else
          a(href="/")
            | Inicio
          a(href="/search")
            | Explorar

    .footer-bottom
      span © 2026 Fotaza2
      span Una red social para amantes de la fotografía.


//- Bootstrap JS
script(
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
)

block scripts

