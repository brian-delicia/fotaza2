
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")

    title= title || "Fotaza"

    // Bootstrap
    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    )

    // Bootstrap Icons
    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    )

    // Nuestro CSS
    link(
      rel="stylesheet"
      href="/css/styles.css"
    )

  body

    // NAVBAR
    nav.navbar.navbar-expand-lg.fotaza-navbar
      .container

        // LOGO
        a.navbar-brand.fotaza-logo(href="/posts")
          i.bi.bi-camera-fill
          span Fotaza

        // BOTON MOBILE
        button.navbar-toggler(
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#fotazaNavbar"
          aria-controls="fotazaNavbar"
          aria-expanded="false"
          aria-label="Abrir menú"
        )
          i.bi.bi-list

        .collapse.navbar-collapse#fotazaNavbar

          if user

            // NAVEGACION PRINCIPAL
            ul.navbar-nav.me-auto.mb-2.mb-lg-0

              li.nav-item
                a.nav-link(href="/posts")
                  i.bi.bi-house-door
                  span Inicio

              li.nav-item
                a.nav-link(href="/search")
                  i.bi.bi-search
                  span Explorar

              li.nav-item
                a.nav-link(href="/collections")
                  i.bi.bi-collection
                  span Colecciones

              li.nav-item
                a.nav-link(href="/messages")
                  i.bi.bi-chat-dots
                  span Mensajes

                  if unreadMessagesCount > 0
                    span.notification-badge= unreadMessagesCount

              li.nav-item
                a.nav-link(href="/notifications")
                  i.bi.bi-bell
                  span Notificaciones

                  if unreadNotificationsCount > 0
                    span.notification-badge= unreadNotificationsCount

              if user.role === 'validator'
                li.nav-item
                  a.nav-link.validator-link(href="/validator/reports")
                    i.bi.bi-shield-check
                    span Validador


            // ACCIONES DERECHA
            .fotaza-user-area

              a.create-button(href="/posts/new")
                i.bi.bi-plus-lg
                span Publicar

              a.profile-link(href=`/profile/${user.id}`)
                .profile-avatar
                  i.bi.bi-person-fill

                span.d-none.d-lg-inline= user.username || user.name || "Perfil"

              button.logout-button(
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#logoutModal"
                title="Cerrar sesión"
              )
                i.bi.bi-box-arrow-right


          else

            .auth-buttons.ms-auto
              a.login-button(href="/login")
                i.bi.bi-box-arrow-in-right
                span Iniciar sesión

              a.register-button(href="/register")
                i.bi.bi-person-plus
                span Crear cuenta


    // CONTENIDO
    main.fotaza-main
      .container
        block content


    // MODAL LOGOUT
    if user
      #logoutModal.modal.fade(tabindex="-1")
        .modal-dialog.modal-dialog-centered
          .modal-content.fotaza-modal

            .modal-header
              h5.modal-title
                i.bi.bi-box-arrow-right.me-2
                | Cerrar sesión

              button.btn-close(
                type="button"
                data-bs-dismiss="modal"
                aria-label="Cerrar"
              )

            .modal-body
              p.mb-0
                | ¿Estás seguro de que querés cerrar tu sesión?

            .modal-footer
              button.cancel-button(
                type="button"
                data-bs-dismiss="modal"
              )
                | Cancelar

              a.confirm-logout(href="/logout")
                i.bi.bi-box-arrow-right.me-1
                | Cerrar sesión


    // Bootstrap JS
    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )

